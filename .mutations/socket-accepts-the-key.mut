# The other half of the Phase 3 pin: refusing on the socket too would lock every
# client out while the daemon looked healthy. The test drives a REAL Unix-domain
# socket with the same key that the port just refused.
file: rust/banshee-api/src/routes.rs
test: the_key_is_refused_over_tcp_and_accepted_over_the_socket
---OLD---
        Transport::Unix => keyed.layer(middleware::from_fn_with_state(
            state.clone(),
            auth::require_api_key,
        )),
---NEW---
        Transport::Unix => keyed.layer(middleware::from_fn(auth::refuse_over_tcp)),
