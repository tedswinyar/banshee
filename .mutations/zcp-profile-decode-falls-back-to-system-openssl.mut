# The build user has no default keychain, so plain `security cms -D` fails on a valid
# profile (2026-11-16, banshee-zcp) and /usr/bin/openssl is the decoder that answers.
# With it removed, a real CMS blob is refused where there is no build keychain:
# 'no default keychain and no build keychain: /usr/bin/openssl decodes the profile'
# (and with one, the decode reaches security -k, which the never-invoked pin catches).
file: scripts/lib/entitlements.sh
test: test-entitlements
---OLD---
  if _banshee_profile_try "$out" "$err" /usr/bin/openssl smime -inform der -verify -noverify -in "$profile"; then rm -f "$err"; return 0; fi
---NEW---
  if false; then rm -f "$err"; return 0; fi
