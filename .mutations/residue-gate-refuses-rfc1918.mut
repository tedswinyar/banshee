# A home-LAN address is the residue a pre-publication audit finds most often. The 10/8
# pattern is the one a build host on a home LAN typically needs; without it a pasted
# address passes.
file: scripts/lib/residue-gate.py
test: test-residue-gate
---OLD---
    r"\b10\.\d{1,3}\.\d{1,3}\.\d{1,3}\b",
---NEW---
