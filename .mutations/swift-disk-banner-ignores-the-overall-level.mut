# The disk channel fires on the disk BAND alone. Gating it on the overall level
# is the exact defect of banshee-3ue: a red disk behind a redder CPU, or a yellow
# disk under a Restless verdict, is never named.
file: swift/Sources/BansheeCore/Notifications.swift
test: testDiskYellowNotifiesOnEntryThenRarely
---OLD---
        guard let reading, let band, band > .green else { return nil }
---NEW---
        guard let reading, let band, band > .green, pressure.level.warrantsNotification else { return nil }
